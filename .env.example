# Docker deployment configuration (copy to .env)
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (fill one or both; you can also leave empty and configure in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# Membrane encryption keys (32 bytes each, base64). Generate once, back them up:
#   openssl rand -base64 32
# Losing them makes the stored client mapping unreadable and all LLM calls will refuse to run.
ARTEX_MEMBRANE_KEY=
ARTEX_MEMBRANE_HMAC_KEY=
